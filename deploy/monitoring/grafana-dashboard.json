{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "ML Inference Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\"forecast-service|vision-service|pricing-service|recommendation-service\"}[1m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "title": "Agent Guardrail Policy Rejection Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(agent_audit_log_count{status=\"REJECTED\"})",
          "legendFormat": "Rejections"
        }
      ]
    },
    {
      "title": "ML Inference Latency (p95 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}} p95"
        }
      ]
    },
    {
      "title": "Horizontal Pod Autoscaler (HPA) Active Replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "kube_hpa_status_current_replicas{namespace=\"intellivend\"}",
          "legendFormat": "{{hpa}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["intellivend", "mlops", "agentic"],
  "time": {
    "from": "now-1h",
    "to": "now font-sans"
  },
  "title": "IntelliVend Fleet & MLOps Operational Dashboard"
}
